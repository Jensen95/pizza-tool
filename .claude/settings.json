{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "jq -r '.tool_input.file_path // empty' | xargs -I{} npx prettier --write --ignore-unknown '{}' 2>/dev/null; exit 0"
					}
				]
			}
		]
	},
	"permissions": {
		"deny": [
			"Bash(npm install --engine-strict=false*)",
			"Bash(npm install --ignore-engines*)",
			"Bash(npm ci --ignore-engines*)"
		],
		"allow": [
			"Bash(ls:*)",
			"Bash(npm run lint:*)",
			"Bash(npm test:*)",
			"Bash(npx svelte-check:*)",
			"Bash(npx vitest run)",
			"Bash(npm run format:*)",
			"Bash(npx vitest:*)",
			"Bash(npm run typecheck:*)",
			"Bash(npm run typescript:check:*)",
			"Bash(npm run format:check:*)",
			"Bash(npm run svelte:check:*)",
			"Bash(npm run dev:*)",
			"Bash(npm run build:*)",
			"Bash(npm run test:e2e:*)",
			"Bash(npm run test:screenshots:*)",
			"Bash(npx @sveltejs/mcp:*)",
			"Bash(agent-browser:*)",
			"Bash(npx agent-browser:*)"
		]
	}
}
