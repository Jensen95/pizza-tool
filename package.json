{
	"name": "pizza-tool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"svelte:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "npm run svelte:check && npm run typescript:check",
		"typescript:check": "tsc --noEmit",
		"generate:icons": "node scripts/generate-icons.mjs",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:ui": "vitest --ui",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:screenshots": "playwright test src/tests/e2e/screenshots.spec.ts --config=playwright.config.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"@typescript-eslint/parser": "^8.56.0",
		"@vitest/ui": "^4.0.18",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"happy-dom": "^20.8.3",
		"jsdom": "^28.1.0",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"sharp": "^0.34.5",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"workbox-window": "^7.4.0"
	},
	"overrides": {
		"@typescript-eslint/eslint-plugin": {
			"eslint": "$eslint"
		},
		"@typescript-eslint/parser": {
			"eslint": "$eslint"
		},
		"eslint-plugin-svelte": {
			"eslint": "$eslint"
		}
	}
}
