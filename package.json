{
	"name": "pizza-tool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"svelte:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "npm run svelte:check && npm run typescript:check",
		"typescript:check": "tsc --noEmit",
		"generate:icons": "node scripts/generate-icons.mjs",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:ui": "vitest --ui",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:screenshots": "playwright test src/tests/e2e/screenshots.spec.ts --config=playwright.config.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.56.0",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"happy-dom": "^20.11.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"workbox-window": "^7.4.1"
	},
	"lint-staged": {
		"*.{svelte,ts,js,css,json,md}": "prettier --write",
		"*.{svelte,ts,js}": "eslint --fix --max-warnings=0"
	},
	"overrides": {
		"@typescript-eslint/eslint-plugin": {
			"eslint": "$eslint"
		},
		"@typescript-eslint/parser": {
			"eslint": "$eslint"
		},
		"eslint-plugin-svelte": {
			"eslint": "$eslint"
		}
	}
}
